module(
    name = "ussi",
    version = "0.1.0",
)

bazel_dep(name = "rules_java", version = "9.7.0")
bazel_dep(name = "rules_jvm_external", version = "7.1")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        "com.carrotsearch:hppc:0.7.1",
        "com.google.code.findbugs:jsr305:3.0.2",
        "com.google.guava:guava:32.1.3-jre",
        "jakarta.validation:jakarta.validation-api:2.0.2",
        "org.apache.commons:commons-math3:3.6.1",
        "org.bytedeco:javacpp:1.5.7",
        "org.bytedeco:openblas:0.3.19-1.5.7",
        "org.bytedeco:openblas:jar:linux-arm64:0.3.19-1.5.7",
        "org.bytedeco:openblas:jar:linux-x86_64:0.3.19-1.5.7",
        "org.bytedeco:openblas:jar:macosx-x86_64:0.3.19-1.5.7",
        "org.junit.jupiter:junit-jupiter-api:6.0.1",
        "org.junit.jupiter:junit-jupiter-engine:6.0.1",
        "org.junit.platform:junit-platform-console:6.0.1",
        "org.projectlombok:lombok:1.18.42",
    ],
    repositories = [
        "https://repo1.maven.org/maven2",
    ],
)
use_repo(maven, "maven")
